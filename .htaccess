ModPagespeedEnableFilters inline_javascript

RewriteEngine On

# 🔁 Redirect /app/... to Firebase Hosting
RewriteRule ^app(/.*)?$ https://hitch-e4a25.web.app/app$1 [R=302,L,QSA]

# 🔁 Redirect /webapp/... to Firebase Hosting
RewriteRule ^webapp(/.*)?$ https://hitch-e4a25.web.app/webapp$1 [R=302,L,QSA]

# Existing trip rewrite
RewriteRule ^trip/(.*)$ /trip-page.php?tripId=$1 [L,R=301]
